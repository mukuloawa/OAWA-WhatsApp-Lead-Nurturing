# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file (it is already in .gitignore).
#
# See DESIGN.md Section 11 for the full description of each variable,
# and docs/phase0-findings.md for what has and hasn't been verified
# against the real Synamate/GHL account yet.

# --- Required ---

ANTHROPIC_API_KEY=

# GHL_TOKEN: a Private Integration token generated in the Synamate UI.
# Not yet generated/verified for this service — see docs/phase0-findings.md §4.
GHL_TOKEN=
GHL_LOCATION_ID=FlT9bndDcWIrmuveZWZa

WEBHOOK_SECRET=
ADMIN_SECRET=

# Local dev / tests: sqlite+aiosqlite:///./dev.db
# Production: a real Postgres URL (Cloud SQL, Neon, Supabase, ...)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

WEBINAR_LINK=
SESSION_WHEN=Saturday, 11:00 AM IST

# --- Optional (defaults shown; see DESIGN.md Section 11) ---

CLAUDE_MODEL=claude-sonnet-5
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
SEND_MODE=dry_run
BOT_ENABLED=true
SESSION_NAME=AUM Strategic Diagnostic
SESSION_COST=free
DEBOUNCE_SECONDS=20
WINDOW_SAFETY_HOURS=23.5
MAX_BOT_TURNS=10
MAX_DIAGNOSIS_TURNS=3
ESCALATION_MESSAGE=Thanks, let me get someone from the OAWA team to pick this up with you personally.
OPTOUT_MESSAGE=Understood, you won't receive any more messages from us. Take care!
RETENTION_DAYS=180
LOG_LEVEL=INFO
